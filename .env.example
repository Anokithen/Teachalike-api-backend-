# Database: use the Railway service URL in production, or the DB_* values locally.
# MYSQL_URL=${{MySQL.MYSQL_URL}}
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=teachalike_db

# Authentication and browser access.
JWT_SECRET_KEY=replace-with-a-unique-secret-at-least-32-characters-long
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
GOOGLE_AUTH_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Cloudinary asset storage. Keep all credentials on the API service.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Voice cloning and generated narration.
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Book generation and pronunciation scoring.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Per-account/session protection for ASR and scoring requests.
PRONUNCIATION_RATE_LIMIT_ATTEMPTS=60
PRONUNCIATION_RATE_LIMIT_WINDOW_SECONDS=3600

# Kimi mini-game generation through NVIDIA NIM.
KIMI_API_KEY=your-nvidia-api-key
KIMI_MODEL=moonshotai/kimi-k2.6
KIMI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
KIMI_REQUEST_TIMEOUT=120

# Pronunciation recording transcription and other NVIDIA-backed helpers.
NVIDIA_API_KEY=your-nvidia-api-key

# Transactional email. Use `console` locally, `gmail_api` or `gmail_smtp` in production.
MAIL_TRANSPORT=console
MAIL_FROM_NAME=TeachAlike
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_REPLY_TO=support@example.com
MAIL_CONNECT_TIMEOUT_SECONDS=10
MAIL_SEND_TIMEOUT_SECONDS=20
MAIL_MAX_ATTEMPTS=5

# Preferred Gmail API transport. Scope: https://www.googleapis.com/auth/gmail.send
GMAIL_CLIENT_ID=your-gmail-oauth-client-id
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-oauth-refresh-token

# Alternative Gmail SMTP transport. Use a Google App Password or OAuth SMTP credentials.
GMAIL_SMTP_USERNAME=your-gmail-address@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-google-app-password
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

# The backend builds its MySQL connection from exactly these five variables.
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=teachalike_db
PORT=5000
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
AUTO_CREATE_TABLES=true
DB_INIT_MAX_ATTEMPTS=5
DB_INIT_RETRY_SECONDS=2
DB_QUERY_TIMEOUT_SECONDS=30
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_ATTEMPTS=20
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
PIN_RATE_LIMIT_ATTEMPTS=5
PIN_RATE_LIMIT_WINDOW_SECONDS=300
ACCOUNT_PASSWORD_RATE_LIMIT_ATTEMPTS=5
ACCOUNT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=300
MAX_JSON_BODY_SIZE_BYTES=1048576
# Comma-separated web origins allowed to call this API. Use * temporarily or
# replace it with the exact deployed Vercel/custom-domain origin.
FRONTEND_ORIGINS=*
# Set explicitly for other reverse proxies. Railway is detected automatically.
TRUST_PROXY_HOPS=0
# Optional comma-separated hostnames accepted by Flask.
TRUSTED_HOSTS=

# Get the cloud name from your Cloudinary dashboard. Never commit real values.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_ROOT_FOLDER=teachalike
CLOUDINARY_DELIVERY_TIMEOUT_SECONDS=60
# Maximum time for one server-to-Cloudinary upload request.
CLOUDINARY_UPLOAD_TIMEOUT_SECONDS=180
# Allows Cloudinary storage and ElevenLabs cloning to finish in one request.
GUNICORN_TIMEOUT=300

# Flask's request-wide limit must be at least the largest per-asset limit.
MAX_CONTENT_LENGTH_MB=1000
MAX_PROFILE_IMAGE_SIZE_MB=10
MAX_CHILD_IMAGE_SIZE_MB=10
MAX_VOICE_PROFILE_SIZE_MB=50
MAX_BOOK_AUDIO_SIZE_MB=250
MAX_BOOK_VIDEO_SIZE_MB=1000

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE_CODE=
ELEVENLABS_MAX_CHARS_PER_CHUNK=4500
ELEVENLABS_REQUEST_TIMEOUT=120
# Optional override when ffmpeg is not available on PATH.
# FFMPEG_BINARY=/usr/bin/ffmpeg

# Gemini generates book-grounded story word quiz questions on the API server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT=45

# Groq is used for book drafts and pronunciation scoring by default.
# Never commit the real key. The key must stay on the API server.
BOOK_GENERATION_PROVIDER=groq
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REQUEST_TIMEOUT=60

# Legacy providers remain available when explicitly selected above.
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-120b
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_REQUEST_TIMEOUT=60

# NVIDIA hosted ASR for pronunciation recordings. Keep the key server-side.
NVIDIA_ASR_API_KEY=
NVIDIA_ASR_API_URL=https://1598d209-5e27-4d3c-8079-4751568b1081.invocation.api.nvcf.nvidia.com/v1/audio/transcriptions
NVIDIA_ASR_LANGUAGE=en-US
NVIDIA_ASR_REQUEST_TIMEOUT=45
NVIDIA_PRONUNCIATION_API_KEY=
NVIDIA_PRONUNCIATION_REQUEST_TIMEOUT=20

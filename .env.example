# Database: use the Railway service URL in production, or the DB_* values locally.
# MYSQL_URL=${{MySQL.MYSQL_URL}}
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=teachalike_db

# Authentication and browser access.
JWT_SECRET_KEY=replace-with-a-unique-secret-at-least-32-characters-long
FRONTEND_ORIGINS=http://localhost:3000

# Cloudinary asset storage. Keep all credentials on the API service.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Voice cloning and generated narration.
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Book generation and pronunciation scoring.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Per-account/session protection for ASR and scoring requests.
PRONUNCIATION_RATE_LIMIT_ATTEMPTS=60
PRONUNCIATION_RATE_LIMIT_WINDOW_SECONDS=3600

# Kimi mini-game generation through NVIDIA NIM.
KIMI_API_KEY=your-nvidia-api-key
KIMI_MODEL=moonshotai/kimi-k2.6
KIMI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
KIMI_REQUEST_TIMEOUT=120

# Pronunciation recording transcription and other NVIDIA-backed helpers.
NVIDIA_API_KEY=your-nvidia-api-key
